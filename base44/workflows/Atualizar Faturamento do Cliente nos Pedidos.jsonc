{
  "name": "Atualizar Faturamento do Cliente nos Pedidos",
  "description": "Quando o endere\u00e7o do cadastro do cliente \u00e9 alterado, atualiza automaticamente o endere\u00e7o de faturamento dos pedidos que ainda n\u00e3o foram faturados. Pedidos j\u00e1 faturados ou cancelados n\u00e3o s\u00e3o alterados.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Client"
    },
    "condition": "${ ((.trigger.changed_fields // []) | map(select(. == \"zip_code\" or . == \"street\" or . == \"number\" or . == \"complement\" or . == \"neighborhood\" or . == \"city\" or . == \"state\")) | length) > 0 }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "atualizar_faturamento_cliente_pedidos",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sincronizar_endereco": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncClientAddressToOS",
            "args": {
              "client_id": "${ .trigger.entity_id }",
              "sales_only": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Atualizar faturamento dos pedidos",
            "description": "Somente pedidos sem nota emitida"
          }
        }
      }
    ]
  }
}