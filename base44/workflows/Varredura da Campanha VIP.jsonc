{
  "name": "Varredura da Campanha VIP",
  "description": "A cada 5 minutos procura no CRM quem clicou em QUERO SER VIP e ainda n\u00e3o foi respondido, e dispara a resposta autom\u00e1tica (link de ades\u00e3o + imagem + \u00e1udio).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "varredura_campanha_vip",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "varrer_cliques_vip": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "vipCampaignSweep",
            "args": {
              "dryRun": false
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Responder cliques VIP",
            "description": "L\u00ea as conversas e responde"
          }
        }
      }
    ]
  }
}