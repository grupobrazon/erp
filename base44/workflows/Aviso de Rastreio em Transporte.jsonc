{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "aviso_de_rastreio_em_transporte",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "avisar_rastreio_em_transporte": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendRomaneioTracking",
            "args": {
              "mode": "sweep"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Cuidar dos avisos de rastreio",
            "description": "OS que entraram em transporte: envia o c\u00f3digo, pergunta se o cliente pode falar e espera a resposta"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "A cada 5 minutos verifica as OS que entraram em Em Transporte: envia o c\u00f3digo de rastreio no WhatsApp, pergunta ao cliente se ele pode falar agora quando a janela est\u00e1 fechada e repete a pergunta a cada 24 horas at\u00e9 ele responder",
  "name": "Aviso de Rastreio em Transporte"
}