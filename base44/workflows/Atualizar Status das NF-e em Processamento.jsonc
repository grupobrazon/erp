{
  "description": "Consulta a Focus NFe a cada 5 minutos e atualiza as NF-e que ficaram em processamento na SEFAZ, autorizando-as ou registrando a rejei\u00e7\u00e3o sem depender da consulta manual.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Atualizar Status das NF-e em Processamento",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "atualizar_status_nfe_processamento",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sincronizar_nfe": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncPendingNFe"
          },
          "then": "end",
          "x-base44": {
            "title": "Consultar NF-e em processamento",
            "description": "Focus NFe \u2014 a cada 5 minutos"
          }
        }
      }
    ]
  }
}