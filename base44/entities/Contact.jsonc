{
  "name": "Contact",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "name": {
      "type": "string",
      "description": "Nome do contato"
    },
    "role": {
      "type": "string",
      "description": "Cargo (Financeiro, Comprador, etc.)"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "name"
  ]
}