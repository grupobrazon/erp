{
  "name": "ChartOfAccount",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo da conta (ex: 5101, 8301)"
    },
    "name": {
      "type": "string",
      "description": "Nome/descri\u00e7\u00e3o da conta"
    },
    "detail": {
      "type": "string",
      "description": "Detalhamento da conta"
    },
    "nature": {
      "type": "string",
      "enum": [
        "Receita",
        "Dedu\u00e7\u00e3o",
        "Custo",
        "Despesa",
        "Ativo",
        "Imposto s/ Lucro",
        "Antecipa\u00e7\u00e3o"
      ],
      "description": "Natureza da conta (derivada do grupo)"
    },
    "group_number": {
      "type": "string",
      "description": "N\u00famero do grupo"
    },
    "group_name": {
      "type": "string",
      "description": "Nome do grupo (Receitas, Dedu\u00e7\u00f5es, Custos, Despesas, Ativos...)"
    },
    "subgroup_number": {
      "type": "string",
      "description": "N\u00famero do subgrupo"
    },
    "subgroup_name": {
      "type": "string",
      "description": "Nome do subgrupo"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Conta ativa ou inativa"
    }
  },
  "required": [
    "code",
    "name",
    "nature"
  ]
}