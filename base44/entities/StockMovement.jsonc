{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Entrada",
        "Sa\u00edda"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "Compra",
        "Ajuste",
        "Devolu\u00e7\u00e3o",
        "Venda",
        "Manuten\u00e7\u00e3o",
        "Troca em garantia",
        "Perda"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "stock_location_id": {
      "type": "string",
      "description": "ID do local de estoque onde ocorreu a movimenta\u00e7\u00e3o"
    },
    "stock_location_name": {
      "type": "string",
      "description": "Nome do local de estoque (cache)"
    },
    "notes": {
      "type": "string"
    },
    "reference_id": {
      "type": "string",
      "description": "ID da venda, manuten\u00e7\u00e3o, etc."
    }
  },
  "required": [
    "product_id",
    "type",
    "reason",
    "quantity",
    "date"
  ]
}