{
  "name": "ServiceType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do tipo de servi\u00e7o de atendimento (ex: Instala\u00e7\u00e3o de purificador de \u00e1gua, Troca de elemento filtrante)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do servi\u00e7o (opcional)"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60,
      "description": "Tempo m\u00e9dio que o servi\u00e7o leva (minutos). Usado pela agenda para calcular a dura\u00e7\u00e3o do atendimento."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Tipo de servi\u00e7o ativo para sele\u00e7\u00e3o nas vendas"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o no seletor"
    }
  },
  "required": [
    "name"
  ]
}