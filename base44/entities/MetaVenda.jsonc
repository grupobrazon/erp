{
  "name": "MetaVenda",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da meta"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Prospec\u00e7\u00e3o",
        "Ticket M\u00e9dio",
        "Produto",
        "Faturamento",
        "Outros"
      ],
      "default": "Prospec\u00e7\u00e3o",
      "description": "Tipo da meta (n\u00e3o relacionada \u00e0 distribui\u00e7\u00e3o)"
    },
    "seller_id": {
      "type": "string",
      "description": "ID da vendedora respons\u00e1vel (vazio = meta geral para todas)"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome da vendedora (cache)"
    },
    "goal_value": {
      "type": "number",
      "description": "Valor/alvo da meta"
    },
    "current_value": {
      "type": "number",
      "default": 0,
      "description": "Progresso atual (atualizado manualmente ou por automa\u00e7\u00e3o)"
    },
    "unit": {
      "type": "string",
      "description": "Unidade de medida (ex: clientes, R$, unidades, %)"
    },
    "goal_date": {
      "type": "string",
      "format": "date",
      "description": "Prazo final da meta"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativa",
        "Conclu\u00edda",
        "Arquivada"
      ],
      "default": "Ativa",
      "description": "Status da meta"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "name",
    "tipo",
    "goal_value",
    "goal_date"
  ]
}