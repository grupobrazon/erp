{
  "name": "IntegracaoLog",
  "type": "object",
  "properties": {
    "origem": {
      "type": "string",
      "enum": [
        "pull",
        "webhook",
        "vinculo"
      ],
      "description": "Origem: pull (sincroniza\u00e7\u00e3o), webhook (evento recebido) ou vinculo (conflito de vincula\u00e7\u00e3o entre cliente do ERP e contato do CRM \u2014 nada foi vinculado)"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem de erro"
    },
    "status_http": {
      "type": "number",
      "description": "Status HTTP retornado (ex: 429, 502, 401, 0 quando n\u00e3o aplic\u00e1vel)"
    },
    "payload_resumido": {
      "type": "object",
      "description": "Resumo do payload/contexto do erro",
      "additionalProperties": true
    },
    "revisado": {
      "type": "boolean",
      "default": false,
      "description": "Erro j\u00e1 revisado por um admin"
    }
  },
  "required": [
    "origem",
    "mensagem"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}