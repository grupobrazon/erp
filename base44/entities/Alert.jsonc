{
  "name": "Alert",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio destinat\u00e1rio do alerta"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio (cache)"
    },
    "type": {
      "type": "string",
      "enum": [
        "Reprova\u00e7\u00e3o Financeira",
        "Estorno de Pedido",
        "Cancelamento - Aprova\u00e7\u00e3o",
        "Cancelamento - Estorno",
        "Outro"
      ],
      "description": "Tipo do alerta"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo curto do alerta"
    },
    "message": {
      "type": "string",
      "description": "Mensagem detalhada com o motivo"
    },
    "related_sale_id": {
      "type": "string",
      "description": "ID da venda relacionada"
    },
    "related_order_number": {
      "type": "string",
      "description": "N\u00famero do pedido relacionado (cache)"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Usu\u00e1rio tomou ci\u00eancia do alerta"
    },
    "read_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data em que o usu\u00e1rio tomou ci\u00eancia"
    },
    "created_by_name": {
      "type": "string",
      "description": "Nome de quem gerou o alerta"
    }
  },
  "required": [
    "user_id",
    "type",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}