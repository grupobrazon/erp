{
  "name": "AutomacaoCredencial",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome amig\u00e1vel da credencial (referenciado nos n\u00f3s HTTP)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "basic",
        "bearer",
        "api_key",
        "header"
      ],
      "description": "Tipo de autentica\u00e7\u00e3o"
    },
    "header_name": {
      "type": "string",
      "description": "Nome do header (api_key/header)"
    },
    "secret_name": {
      "type": "string",
      "description": "Nome do secret do app com o valor real (process.env.<secret_name>)"
    },
    "username_ref": {
      "type": "string",
      "description": "Secret com username (basic auth)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Credencial ativa"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "nome",
    "tipo",
    "secret_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}