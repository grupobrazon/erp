{
  "name": "CalendarioRota",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do calend\u00e1rio (ex: Belo Horizonte, Contagem, Grande BH)"
    },
    "color": {
      "type": "string",
      "enum": [
        "blue",
        "green",
        "amber",
        "purple",
        "rose",
        "cyan",
        "orange",
        "indigo"
      ],
      "default": "blue",
      "description": "Cor do calend\u00e1rio (usada nos agendamentos e filtros)"
    },
    "city": {
      "type": "string",
      "description": "Cidade associada ao calend\u00e1rio (opcional \u2014 legado, use center_city para a regi\u00e3o de atua\u00e7\u00e3o)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/observa\u00e7\u00e3o do calend\u00e1rio"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Calend\u00e1rio ativo"
    },
    "allow_any_region": {
      "type": "boolean",
      "default": false,
      "description": "Permite agendar clientes de qualquer regi\u00e3o (sem valida\u00e7\u00e3o de zona/rota). Use para calend\u00e1rios gen\u00e9ricos/avulsos que n\u00e3o exigem regi\u00e3o atribu\u00edda ao cliente."
    },
    "group_id": {
      "type": "string",
      "description": "ID do grupo de calend\u00e1rios ao qual este calend\u00e1rio pertence. O pool de t\u00e9cnicos \u00e9 compartilhado entre todos os calend\u00e1rios do mesmo grupo \u2014 cada t\u00e9cnico atende apenas uma regi\u00e3o (calend\u00e1rio) por dia. O dia \u00e9 dividido pela quantidade de t\u00e9cnicos do grupo."
    },
    "group_name": {
      "type": "string",
      "description": "Nome do grupo (cache)"
    },
    "state": {
      "type": "string",
      "description": "Estado/UF da regi\u00e3o de atua\u00e7\u00e3o (ex: SP, MG, RJ)"
    },
    "center_city": {
      "type": "string",
      "description": "Cidade central da regi\u00e3o de atua\u00e7\u00e3o (ex: S\u00e3o Paulo, Belo Horizonte)"
    },
    "coverage_radius_km": {
      "type": "number",
      "description": "Raio de atua\u00e7\u00e3o em km a partir da cidade central (ex: 50 = atende cidades num raio de 50km da capital)"
    },
    "center_lat": {
      "type": "number",
      "description": "Latitude do centro da regi\u00e3o de atua\u00e7\u00e3o (definido pelo mapa)"
    },
    "center_lng": {
      "type": "number",
      "description": "Longitude do centro da regi\u00e3o de atua\u00e7\u00e3o (definido pelo mapa)"
    },
    "coverage_cities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cidades atendidas dentro do raio de atua\u00e7\u00e3o (gerado/refinado pela IA ou manual)"
    },
    "period_mode": {
      "type": "string",
      "enum": [
        "Dia Inteiro",
        "Periodos"
      ],
      "default": "Dia Inteiro",
      "description": "Modo de per\u00edodo do calend\u00e1rio: Dia Inteiro = agenda fechada o dia todo para a regi\u00e3o | Periodos = agenda dividida em Manh\u00e3 e Tarde (cada per\u00edodo pode ter sua pr\u00f3pria regi\u00e3o)"
    },
    "service_start_time": {
      "type": "string",
      "description": "Hor\u00e1rio de in\u00edcio do atendimento (HH:MM, ex: 08:00)"
    },
    "service_end_time": {
      "type": "string",
      "description": "Hor\u00e1rio de fim do atendimento (HH:MM, ex: 18:00)"
    },
    "lunch_start_time": {
      "type": "string",
      "description": "In\u00edcio do intervalo de almo\u00e7o (HH:MM, ex: 12:00). Vazio = sem intervalo."
    },
    "lunch_end_time": {
      "type": "string",
      "description": "Fim do intervalo de almo\u00e7o (HH:MM, ex: 13:00). Vazio = sem intervalo."
    },
    "technicians_count": {
      "type": "number",
      "default": 1,
      "description": "Quantos t\u00e9cnicos atendem simultaneamente neste calend\u00e1rio por per\u00edodo (compatibilidade \u2014 derivado do grupo)."
    },
    "capacity_moto_manha": {
      "type": "number",
      "default": 4,
      "description": "M\u00e9dia de atendimentos de moto que cabem no per\u00edodo da manh\u00e3 (ou dia inteiro, quando period_mode = Dia Inteiro)"
    },
    "capacity_moto_tarde": {
      "type": "number",
      "default": 5,
      "description": "M\u00e9dia de atendimentos de moto que cabem no per\u00edodo da tarde (ignorado quando period_mode = Dia Inteiro)"
    },
    "capacity_carro_manha": {
      "type": "number",
      "default": 4,
      "description": "M\u00e9dia de atendimentos de carro que cabem no per\u00edodo da manh\u00e3 (ou dia inteiro, quando period_mode = Dia Inteiro)"
    },
    "capacity_carro_tarde": {
      "type": "number",
      "default": 5,
      "description": "M\u00e9dia de atendimentos de carro que cabem no per\u00edodo da tarde (ignorado quando period_mode = Dia Inteiro)"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "Moto",
        "Carro",
        "Ambos"
      ],
      "description": "Tipo de ve\u00edculo utilizado pelos t\u00e9cnicos deste calend\u00e1rio (compatibilidade \u2014 quando todos os t\u00e9cnicos usam o mesmo ve\u00edculo)"
    },
    "min_advance_business_days": {
      "type": "number",
      "default": 2,
      "description": "Dias \u00fateis m\u00ednimos de anteced\u00eancia para agendamento (bloqueia o vendedor de marcar com menos anteced\u00eancia). Padr\u00e3o 2 \u2014 d\u00e1 tempo para a log\u00edstica remanejar agendas entre o agendamento e o atendimento."
    },
    "car_first_rule": {
      "type": "boolean",
      "default": true,
      "description": "Regra do primeiro carro: o primeiro atendimento do t\u00e9cnico de carro no dia deve ser de um cliente que precisa de carro. Ap\u00f3s o primeiro carro, clientes de moto podem ser puxados para o t\u00e9cnico de carro (overflow). S\u00f3 se aplica quando o calend\u00e1rio tem t\u00e9cnicos de carro (vehicle_type = Carro ou Ambos)."
    },
    "moto_can_use_car_slots": {
      "type": "boolean",
      "default": true,
      "description": "Permite que atendimentos de moto ocupem slots de carro quando os slots de moto estiverem cheios (overflow). Desative para for\u00e7ar que moto s\u00f3 use slots de moto."
    },
    "technicians": {
      "type": "array",
      "description": "T\u00e9cnicos alocados a este calend\u00e1rio (compatibilidade \u2014 espelho do pool do grupo). O pool de t\u00e9cnicos \u00e9 gerenciado no CalendarGroup vinculado em group_id. Este campo \u00e9 sincronizado automaticamente quando o grupo \u00e9 salvo.",
      "items": {
        "type": "object",
        "properties": {
          "technician_id": {
            "type": "string",
            "description": "ID do t\u00e9cnico cadastrado (entidade Technician)"
          },
          "technician_name": {
            "type": "string",
            "description": "Nome do t\u00e9cnico (cache)"
          },
          "vehicle_type": {
            "type": "string",
            "enum": [
              "Moto",
              "Carro"
            ],
            "description": "Ve\u00edculo deste t\u00e9cnico neste calend\u00e1rio (sobrescreve o padr\u00e3o do cadastro)"
          }
        }
      }
    },
    "calendar_services": {
      "type": "array",
      "description": "Servi\u00e7os realizados neste calend\u00e1rio com suas dura\u00e7\u00f5es. O vendedor seleciona um destes ao agendar \u2014 a dura\u00e7\u00e3o \u00e9 preenchida automaticamente.",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "description": "ID do servi\u00e7o (entidade Service)"
          },
          "service_name": {
            "type": "string",
            "description": "Nome do servi\u00e7o (cache)"
          },
          "duration_minutes": {
            "type": "number",
            "default": 60,
            "description": "Dura\u00e7\u00e3o do servi\u00e7o neste calend\u00e1rio (minutos)"
          }
        }
      }
    },
    "period_regions": {
      "type": "array",
      "description": "Regi\u00e3o vinculada a cada per\u00edodo do calend\u00e1rio (regra de permiss\u00e3o de agendamento). Em modo Dia Inteiro: 1 entrada (period=Dia Inteiro). Em modo Periodos: 2 entradas (Manha e Tarde), podendo ser a mesma regi\u00e3o. O vendedor s\u00f3 pode agendar clientes cuja regi\u00e3o atribu\u00edda corresponda ao per\u00edodo selecionado.",
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "Manha",
              "Tarde",
              "Dia Inteiro"
            ]
          },
          "region_id": {
            "type": "string",
            "description": "ID da regi\u00e3o (RouteRegion) vinculada a este per\u00edodo"
          },
          "region_name": {
            "type": "string",
            "description": "Nome da regi\u00e3o (cache)"
          }
        }
      }
    },
    "departure_street": {
      "type": "string",
      "description": "Logradouro do ponto de partida (empresa/escrit\u00f3rio desta regi\u00e3o)"
    },
    "departure_number": {
      "type": "string",
      "description": "N\u00famero do ponto de partida"
    },
    "departure_neighborhood": {
      "type": "string",
      "description": "Bairro do ponto de partida"
    },
    "departure_city": {
      "type": "string",
      "description": "Cidade do ponto de partida"
    },
    "departure_state": {
      "type": "string",
      "description": "UF do ponto de partida"
    },
    "departure_zip": {
      "type": "string",
      "description": "CEP do ponto de partida"
    },
    "departure_lat": {
      "type": "number",
      "description": "Latitude do ponto de partida (geocodificada automaticamente)"
    },
    "departure_lng": {
      "type": "number",
      "description": "Longitude do ponto de partida (geocodificada automaticamente)"
    }
  },
  "required": [
    "name",
    "color"
  ]
}