{
  "name": "DistributionBatch",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "description": "C\u00f3digo do protocolo do lote (DIST-000001)"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a distribui\u00e7\u00e3o foi realizada"
    },
    "mode": {
      "type": "string",
      "enum": [
        "single",
        "equal",
        "planilha"
      ],
      "description": "Modo de distribui\u00e7\u00e3o: single = todos para 1 vendedora | equal = dividido igual entre as vendedoras | planilha = distribu\u00eddo conforme planilha importada"
    },
    "seller_ids": {
      "type": "array",
      "description": "IDs das vendedoras que receberam o lote",
      "items": {
        "type": "string"
      }
    },
    "seller_names": {
      "type": "array",
      "description": "Nomes das vendedoras que receberam o lote (cache)",
      "items": {
        "type": "string"
      }
    },
    "client_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de clientes distribu\u00eddos neste lote"
    },
    "client_ids": {
      "type": "array",
      "description": "IDs dos clientes distribu\u00eddos neste lote (para estorno)",
      "items": {
        "type": "string"
      }
    },
    "reversed": {
      "type": "boolean",
      "default": false,
      "description": "Lote estornado (distribui\u00e7\u00e3o desfeita)"
    },
    "reversed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do estorno"
    },
    "reversed_by": {
      "type": "string",
      "description": "Nome de quem estornou o lote"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "protocol",
    "date"
  ]
}