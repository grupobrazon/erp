{
  "name": "Service",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do servi\u00e7o na lista LC 116/2003 (ex: 1.01, 7.01)"
    },
    "name": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do servi\u00e7o (item da LC 116)"
    },
    "aliquot_iss": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota padr\u00e3o de ISS (%)"
    },
    "municipal_service_code": {
      "type": "string",
      "description": "C\u00f3digo municipal do servi\u00e7o (override do c\u00f3digo da prefeitura para NFS-e)"
    },
    "national_tributation_code": {
      "type": "string",
      "description": "C\u00f3digo de tributa\u00e7\u00e3o nacional (6 d\u00edgitos) para NFS-e Nacional \u2014 ex: 140101 para manuten\u00e7\u00e3o/instala\u00e7\u00e3o de equipamentos"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Servi\u00e7o ativo ou inativo"
    }
  },
  "required": [
    "code",
    "name"
  ]
}