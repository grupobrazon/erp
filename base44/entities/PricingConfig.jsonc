{
  "name": "PricingConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Identificador da configura\u00e7\u00e3o (singleton: 'default')"
    },
    "icms_mg_percent": {
      "type": "number",
      "default": 6.0,
      "description": "ICMS efetivo \u2014 vendas dentro de MG (%)"
    },
    "icms_fora_mg_percent": {
      "type": "number",
      "default": 1.3,
      "description": "ICMS efetivo \u2014 vendas fora de MG / TTS (%)"
    },
    "pis_percent": {
      "type": "number",
      "default": 0.65,
      "description": "PIS (%)"
    },
    "cofins_percent": {
      "type": "number",
      "default": 3.0,
      "description": "COFINS (%)"
    },
    "irpj_percent": {
      "type": "number",
      "default": 1.2,
      "description": "IRPJ efetivo (%)"
    },
    "csll_percent": {
      "type": "number",
      "default": 1.08,
      "description": "CSLL efetiva (%)"
    },
    "commission_percent": {
      "type": "number",
      "default": 0,
      "description": "Comiss\u00e3o de vendas (%) \u2014 incide sobre o pre\u00e7o final"
    },
    "marketing_percent": {
      "type": "number",
      "default": 0,
      "description": "Marketing (%) \u2014 incide sobre o pre\u00e7o final"
    },
    "admin_fee_percent": {
      "type": "number",
      "default": 0,
      "description": "Taxa administrativa (%) \u2014 incide sobre o pre\u00e7o final"
    },
    "target_margin_percent": {
      "type": "number",
      "default": 0,
      "description": "Margem de lucro alvo (%) \u2014 incide sobre o pre\u00e7o final"
    },
    "financial_fee_table": {
      "type": "array",
      "description": "Tabela de taxa financeira por n\u00famero de parcelas (incide sobre o pre\u00e7o final)",
      "items": {
        "type": "object",
        "properties": {
          "installments": {
            "type": "number",
            "description": "N\u00famero de parcelas (1 = \u00e0 vista, 12 = pior cen\u00e1rio)"
          },
          "fee_percent": {
            "type": "number",
            "description": "Taxa financeira (%) para esta parcela"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}