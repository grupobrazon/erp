{
  "name": "Product",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do produto (gerado automaticamente a partir do prefixo do grupo)"
    },
    "name": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "short_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta/abrevia\u00e7\u00e3o"
    },
    "brand": {
      "type": "string"
    },
    "group_id": {
      "type": "string",
      "description": "ID do grupo do produto"
    },
    "group_name": {
      "type": "string",
      "description": "Nome do grupo (cache)"
    },
    "subgroup_id": {
      "type": "string",
      "description": "ID do subgrupo do produto"
    },
    "subgroup_name": {
      "type": "string",
      "description": "Nome do subgrupo (cache)"
    },
    "unit": {
      "type": "string",
      "description": "Unidade de estoque"
    },
    "supply_source": {
      "type": "string",
      "description": "Fonte de fornecimento"
    },
    "product_type": {
      "type": "string",
      "description": "Tipo de produto"
    },
    "ncm": {
      "type": "string",
      "description": "Classifica\u00e7\u00e3o Fiscal (NCM)"
    },
    "weight": {
      "type": "number",
      "description": "Peso (kg)"
    },
    "width": {
      "type": "number",
      "description": "Largura (cm)"
    },
    "length": {
      "type": "number",
      "description": "Comprimento (cm)"
    },
    "depth": {
      "type": "number",
      "description": "Profundidade (cm)"
    },
    "volume": {
      "type": "number",
      "description": "Volume (m\u00b3)"
    },
    "packaging": {
      "type": "string",
      "description": "Embalagem"
    },
    "origin": {
      "type": "string",
      "enum": [
        "Nacional",
        "Importado"
      ],
      "default": "Nacional",
      "description": "Origem do produto"
    },
    "cost": {
      "type": "number",
      "description": "Custo"
    },
    "sale_price": {
      "type": "number",
      "description": "Pre\u00e7o de venda"
    },
    "target_margin_percent": {
      "type": "number",
      "default": 0,
      "description": "Margem de lucro alvo (%) espec\u00edfica do produto. Sobrescreve a margem do subgrupo, grupo e a global da config de precifica\u00e7\u00e3o."
    },
    "current_stock": {
      "type": "number",
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Produto ativo ou inativo"
    },
    "maintenance_role": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Gera Patrim\u00f4nio",
        "Pe\u00e7a de Manuten\u00e7\u00e3o"
      ],
      "default": "Nenhum",
      "description": "Papel do produto na gest\u00e3o de manuten\u00e7\u00e3o"
    },
    "generates_maintenance": {
      "type": "boolean",
      "default": false,
      "description": "Este produto gera um patrim\u00f4nio no m\u00f3dulo de gest\u00e3o de manuten\u00e7\u00e3o"
    },
    "is_maintenance_part": {
      "type": "boolean",
      "default": false,
      "description": "Este produto \u00e9 uma pe\u00e7a de manuten\u00e7\u00e3o trocada periodicamente"
    },
    "maintenance_interval_months": {
      "type": "number",
      "description": "Periodicidade de manuten\u00e7\u00e3o em meses"
    },
    "maintenance_interval_liters": {
      "type": "number",
      "description": "Periodicidade de manuten\u00e7\u00e3o por litros"
    },
    "maintenance_type": {
      "type": "string",
      "enum": [
        "Tempo",
        "Litros"
      ],
      "default": "Tempo"
    },
    "ph_category": {
      "type": "string",
      "enum": [
        "Neutro",
        "Alcalino"
      ],
      "description": "Categoria de pH do produto (apenas para purificadores, bebedouros e c\u00e1psulas de purifica\u00e7\u00e3o)"
    }
  },
  "required": [
    "name"
  ]
}