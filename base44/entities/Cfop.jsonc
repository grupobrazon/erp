{
  "name": "Cfop",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do CFOP (ex: 5102)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do CFOP (ex: Venda de mercadoria)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Venda",
        "Remessa",
        "Demonstra\u00e7\u00e3o",
        "Devolu\u00e7\u00e3o",
        "Outro"
      ],
      "default": "Venda",
      "description": "Categoria do CFOP"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "description"
  ]
}