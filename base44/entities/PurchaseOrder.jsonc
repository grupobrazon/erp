{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do pedido de compra (PC000001) \u2014 gerado automaticamente"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nome do fornecedor"
    },
    "supplier_document": {
      "type": "string",
      "description": "CNPJ/CPF do fornecedor"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do pedido"
    },
    "expected_delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Previs\u00e3o de entrega"
    },
    "stock_location_id": {
      "type": "string",
      "description": "Local de estoque para entrada das mercadorias"
    },
    "stock_location_name": {
      "type": "string",
      "description": "Nome do local de estoque (cache)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "freight": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "grand_total": {
      "type": "number"
    },
    "payment_condition_id": {
      "type": "string",
      "description": "Condi\u00e7\u00e3o de pagamento (dire\u00e7\u00e3o Pagamento)"
    },
    "payment_condition_name": {
      "type": "string"
    },
    "is_fiscal": {
      "type": "boolean",
      "default": true,
      "description": "Compra fiscal (com NF-e) ou n\u00e3o fiscal"
    },
    "fiscal_doc_url": {
      "type": "string",
      "description": "XML (fiscal) ou PDF (n\u00e3o fiscal) anexado no recebimento"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "invoice_chave": {
      "type": "string",
      "description": "Chave de acesso da NF-e"
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pedido",
        "Recebido",
        "Cancelado"
      ],
      "default": "Pedido"
    },
    "accounts_payable_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos contas a pagar gerados no recebimento"
    },
    "advance_payable_id": {
      "type": "string",
      "description": "Conta a pagar de antecipa\u00e7\u00e3o de fornecedor vinculada"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "supplier_name",
    "date"
  ]
}