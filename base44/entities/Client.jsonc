{
  "name": "Client",
  "type": "object",
  "properties": {
    "new_code": {
      "type": "string",
      "description": "C\u00f3digo gerado automaticamente (B000001)"
    },
    "old_code": {
      "type": "string",
      "description": "C\u00f3digo antigo do ERP anterior (LSOFT)"
    },
    "base_type": {
      "type": "string",
      "enum": [
        "Lsoft",
        "\u00d3timo",
        "Novo"
      ],
      "default": "Novo",
      "description": "Perfil/Base do cliente"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Cliente ativo ou inativo"
    },
    "person_type": {
      "type": "string",
      "enum": [
        "F\u00edsica",
        "Jur\u00eddica"
      ],
      "default": "F\u00edsica",
      "description": "Tipo de pessoa"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "Consumidor Final",
        "Revenda"
      ],
      "description": "Tipo de cliente (apenas Pessoa Jur\u00eddica)"
    },
    "name": {
      "type": "string",
      "description": "Nome (Pessoa F\u00edsica) ou Raz\u00e3o Social (Pessoa Jur\u00eddica)"
    },
    "fantasy_name": {
      "type": "string",
      "description": "Nome Fantasia (Pessoa Jur\u00eddica)"
    },
    "document": {
      "type": "string",
      "description": "CPF (F\u00edsica) ou CNPJ (Jur\u00eddica) - OBRIGAT\u00d3RIO"
    },
    "state_registration": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual"
    },
    "ie_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Empresa isenta de Inscri\u00e7\u00e3o Estadual (ICMS)"
    },
    "email": {
      "type": "string",
      "description": "E-mail principal"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento (Pessoa F\u00edsica)"
    },
    "phone1": {
      "type": "string",
      "description": "Telefone 1"
    },
    "phone1_name": {
      "type": "string",
      "description": "Nome do contato - Telefone 1"
    },
    "phone1_whatsapp": {
      "type": "boolean",
      "description": "Telefone 1 \u00e9 WhatsApp?"
    },
    "phone2": {
      "type": "string",
      "description": "Telefone 2"
    },
    "phone2_name": {
      "type": "string",
      "description": "Nome do contato - Telefone 2"
    },
    "phone2_whatsapp": {
      "type": "boolean",
      "description": "Telefone 2 \u00e9 WhatsApp?"
    },
    "phone3": {
      "type": "string",
      "description": "Telefone 3"
    },
    "phone3_name": {
      "type": "string",
      "description": "Nome do contato - Telefone 3"
    },
    "phone3_whatsapp": {
      "type": "boolean",
      "description": "Telefone 3 \u00e9 WhatsApp?"
    },
    "phone4": {
      "type": "string",
      "description": "Telefone 4"
    },
    "phone4_name": {
      "type": "string",
      "description": "Nome do contato - Telefone 4"
    },
    "phone4_whatsapp": {
      "type": "boolean",
      "description": "Telefone 4 \u00e9 WhatsApp?"
    },
    "phone5": {
      "type": "string",
      "description": "Telefone 5"
    },
    "phone5_name": {
      "type": "string",
      "description": "Nome do contato - Telefone 5"
    },
    "phone5_whatsapp": {
      "type": "boolean",
      "description": "Telefone 5 \u00e9 WhatsApp?"
    },
    "zoox_phone1": {
      "type": "string",
      "description": "Telefone Zoox 1"
    },
    "zoox_phone2": {
      "type": "string",
      "description": "Telefone Zoox 2"
    },
    "zoox_phone3": {
      "type": "string",
      "description": "Telefone Zoox 3"
    },
    "zoox_phone4": {
      "type": "string",
      "description": "Telefone Zoox 4"
    },
    "zoox_phone5": {
      "type": "string",
      "description": "Telefone Zoox 5"
    },
    "zoox_phone6": {
      "type": "string",
      "description": "Telefone Zoox 6"
    },
    "zoox_phone7": {
      "type": "string",
      "description": "Telefone Zoox 7"
    },
    "zip_code": {
      "type": "string",
      "description": "CEP"
    },
    "street": {
      "type": "string",
      "description": "Logradouro"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero"
    },
    "complement": {
      "type": "string",
      "description": "Complemento"
    },
    "neighborhood": {
      "type": "string",
      "description": "Bairro"
    },
    "city": {
      "type": "string",
      "description": "Cidade"
    },
    "state": {
      "type": "string",
      "description": "UF"
    },
    "regional": {
      "type": "string",
      "description": "Regional de atendimento (ex: SP \u2013 Sul 1, MET \u2013 ABC, MET \u2013 Guarulhos). Preenchida automaticamente via tabela de parametriza\u00e7\u00e3o de munic\u00edpios (Grande SP) ou classifica\u00e7\u00e3o do bairro da capital. Usada exclusivamente para organiza\u00e7\u00e3o da agenda de atendimentos. Valor 'N\u00c3O PARAMETRIZADA' quando fora das \u00e1reas cobertas."
    },
    "status": {
      "type": "string",
      "enum": [
        "Base Inativa LSOFT",
        "\u00d3timo - Cliente Brazon",
        "\u00d3timo",
        "\u00d3timo Recorrente",
        "Novo"
      ],
      "default": "Novo",
      "description": "Status/Lista do cliente"
    },
    "last_purchase_date": {
      "type": "string",
      "description": "Data da \u00faltima compra (Ex: out/23)"
    },
    "last_product": {
      "type": "string",
      "description": "Produto ou \u00faltima compra"
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "description": "Data de cadastro"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "clint_contact_id": {
      "type": "string",
      "description": "ID do contato na Clint (sincronizado)"
    },
    "clint_chat_id": {
      "type": "string",
      "description": "ID da conversa na Clint (atendimento)"
    },
    "clint_chat_url": {
      "type": "string",
      "description": "URL da conversa na Clint (dashboard)"
    },
    "clint_deal_id": {
      "type": "string",
      "description": "ID do neg\u00f3cio (deal) mais recente na Clint"
    },
    "clint_deal_url": {
      "type": "string",
      "description": "URL do neg\u00f3cio na Clint (dashboard)"
    },
    "clint_deal_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de neg\u00f3cios (deals) na Clint"
    },
    "seller_id": {
      "type": "string",
      "description": "ID da vendedora respons\u00e1vel pelo cliente (atribu\u00eddo no Painel de Distribui\u00e7\u00e3o)"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome da vendedora respons\u00e1vel (cache)"
    },
    "distribution_batch_id": {
      "type": "string",
      "description": "ID do lote de distribui\u00e7\u00e3o ao qual o cliente foi atribu\u00eddo (DistributionBatch)"
    },
    "ghl_contact_id": {
      "type": "string",
      "description": "ID do contato no GoHighLevel (vinculado por email/nome no pull de enriquecimento)"
    },
    "ghl_tags": {
      "type": "array",
      "description": "Tags do contato no GoHighLevel (enriquecimento \u2014 n\u00e3o sobrescreve dados do ERP)",
      "items": {
        "type": "string"
      }
    },
    "ghl_last_activity_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atividade do contato no GoHighLevel (enriquecimento)"
    },
    "ghl_last_sync_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo enriquecimento sincronizado do GoHighLevel"
    },
    "ghl_deal_id": {
      "type": "string",
      "description": "ID da oportunidade (deal) mais recente no GoHighLevel (atualizado via webhook)"
    },
    "ghl_deal_title": {
      "type": "string",
      "description": "Nome/t\u00edtulo da oportunidade mais recente no GHL (cache)"
    },
    "ghl_deal_status": {
      "type": "string",
      "description": "Status da oportunidade no GHL (open, won, lost, abandoned)"
    },
    "ghl_deal_value": {
      "type": "number",
      "default": 0,
      "description": "Valor monet\u00e1rio da oportunidade no GHL (cache)"
    },
    "ghl_deal_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de oportunidades (deals) recebidas no GHL"
    },
    "ghl_last_deal_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o de oportunidade no GHL"
    },
    "route_zone_id": {
      "type": "string",
      "description": "ID da zona de rota prim\u00e1ria (primeira atribui\u00e7\u00e3o \u2014 compatibilidade. Use route_assignments para a lista completa multi-zona)"
    },
    "route_zone_name": {
      "type": "string",
      "description": "Nome da zona de rota prim\u00e1ria (cache \u2014 compatibilidade)"
    },
    "route_calendar_id": {
      "type": "string",
      "description": "ID do calend\u00e1rio de rota prim\u00e1rio (compatibilidade. Use route_assignments para a lista completa)"
    },
    "route_calendar_name": {
      "type": "string",
      "description": "Nome do calend\u00e1rio de rota prim\u00e1rio (cache \u2014 compatibilidade)"
    },
    "route_assignments": {
      "type": "array",
      "description": "Zonas e calend\u00e1rios de rota atribu\u00eddos ao cliente (multi-zona \u2014 um cliente pode pertencer a v\u00e1rias zonas simultaneamente, ex: zona de bairro + zona de regi\u00e3o metropolitana). Atualizado automaticamente: ao criar calend\u00e1rio/zona (varredura geral) e ao cadastrar cliente (varredura individual).",
      "items": {
        "type": "object",
        "properties": {
          "zone_id": {
            "type": "string"
          },
          "zone_name": {
            "type": "string"
          },
          "calendar_id": {
            "type": "string"
          },
          "calendar_name": {
            "type": "string"
          }
        }
      }
    },
    "address_history": {
      "type": "array",
      "description": "Hist\u00f3rico de altera\u00e7\u00f5es de endere\u00e7o (append-only). Registra o endere\u00e7o anterior, o novo endere\u00e7o, quem alterou e quando.",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Data/hora da altera\u00e7\u00e3o"
          },
          "user_id": {
            "type": "string",
            "description": "ID do usu\u00e1rio que alterou o endere\u00e7o"
          },
          "user_name": {
            "type": "string",
            "description": "Nome do usu\u00e1rio que alterou (cache)"
          },
          "old_address": {
            "type": "object",
            "description": "Endere\u00e7o anterior",
            "properties": {
              "zip_code": {
                "type": "string"
              },
              "street": {
                "type": "string"
              },
              "number": {
                "type": "string"
              },
              "complement": {
                "type": "string"
              },
              "neighborhood": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            }
          },
          "new_address": {
            "type": "object",
            "description": "Novo endere\u00e7o",
            "properties": {
              "zip_code": {
                "type": "string"
              },
              "street": {
                "type": "string"
              },
              "number": {
                "type": "string"
              },
              "complement": {
                "type": "string"
              },
              "neighborhood": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "vip_client": {
      "type": "boolean",
      "default": false,
      "description": "Cliente VIP \u2014 passou a integrar um programa de relacionamento (ex: Programa Cliente VIP Brazon) ap\u00f3s assinar digitalmente o termo de ades\u00e3o"
    },
    "vip_since": {
      "type": "string",
      "format": "date",
      "description": "Data em que o cliente passou a ser VIP"
    },
    "active_promotions": {
      "type": "array",
      "description": "Programas e promo\u00e7\u00f5es ativos deste cliente (preenchido automaticamente quando o cliente aceita o termo de ades\u00e3o)",
      "items": {
        "type": "object",
        "properties": {
          "promotion_id": {
            "type": "string"
          },
          "promotion_name": {
            "type": "string"
          },
          "adhesion_id": {
            "type": "string"
          },
          "discount_percent": {
            "type": "number"
          },
          "is_lifetime": {
            "type": "boolean"
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "person_type",
    "document"
  ]
}